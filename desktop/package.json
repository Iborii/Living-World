{
  "name": "living-world",
  "productName": "Living World",
  "version": "0.6.0",
  "description": "A roleplay world where every character lives their own story.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.livingworld.app",
    "productName": "Living World",
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Living World",
      "uninstallDisplayName": "Living World",
      "include": "build/installer.nsh",
      "artifactName": "Living World Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "livingWorld": {
    "uiVersion": "0.84.0",
    "updateUrl": "https://raw.githubusercontent.com/Iborii/living-world/main/release"
  }
}